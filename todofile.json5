{
    // ---- セットアップ ----
    // 初回だけ。.env が既にあれば上書きしない
    "setup": [
        "composer install",
        "npm install",
        "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
        "php artisan key:generate",
        "php artisan chreeid:generate-key",
        "php artisan migrate",
        "php artisan lang:build",
        "todo phpdoc:install"
    ],
    "migrate": "php artisan migrate",
    "lang": "php artisan lang:build",

    // ---- 確認 ----
    "test": "php artisan test --parallel",
    "test:dox": "vendor/bin/phpunit --testdox",
    "phpstan": "vendor/bin/phpstan analyse",
    "pint": "vendor/bin/pint",
    "pint:test": "vendor/bin/pint --test",
    // コミット前にまとめて通す。書き換えはしない
    "check": [
        "todo lang",
        "todo pint:test",
        "todo phpstan",
        "todo front:tsc",
        "todo test"
    ],

    // ---- ドキュメント ----
    // PHPDoc から HTML を作る (Doctum)。build/doctum/index.html を開く
    "phpdoc": "php tools/doctum.phar update doctum.php",
    // phar は git に入れず、無ければ取ってくる
    "phpdoc:install": "php -r \"file_exists('tools/doctum.phar') || copy('https://doctum.long-term.support/releases/latest/doctum.phar', 'tools/doctum.phar');\"",

    // ---- デプロイ ----
    "deploy": "py tools/deploy.py",

    // ---- フロントエンド ----
    "front:dev": "npm run dev",
    "front:build": "npm run build",
    "front:tsc": "npm run typecheck",

    // ---- 運用 ----
    // 期限切れのトークンと、猶予を過ぎた退会アカウントを消す
    "prune": "php artisan chreeid:prune-tokens"
}
