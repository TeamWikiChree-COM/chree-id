<IfModule mod_rewrite.c>
    RewriteEngine On

    # ドットから始まる隠しファイル（.env など）へのアクセスを遮断。
    # ただし .well-known は RFC 8615 の公開パスなので通す。
    # ここで塞ぐと OIDC ディスカバリが 403 になり、RP が接続先を解決できない
    RewriteCond %{REQUEST_URI} !(^|/)\.well-known/
    RewriteRule ^\.(.*)$ - [F,L]

    # DocumentRoot が public/ ではなくプロジェクト直下なので、
    # 本来公開しないディレクトリが素通しになる。ここで塞ぐ
    RewriteRule ^(vendor|storage|bootstrap|config|database|app|routes|tests|resources|node_modules)/ - [F,L]

    # 設定・依存関係の定義ファイル
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpstan\.neon|vite\.config\.js|artisan)$ - [F,L]

    # Vite のビルド成果物 (JS/CSS) および public 静的アセットへのリライト
    RewriteRule ^build/(.*)$ public/build/$1 [L]
    RewriteRule ^(favicon\.ico|icon\.png|robots\.txt)$ public/$1 [L]

    # 実ファイルやディレクトリが存在する場合はそのまま配信
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# mod_rewrite が無い環境でも最低限は塞ぐ
<FilesMatch "^\.env|^composer\.(json|lock)$|^package(-lock)?\.json$">
    Require all denied
</FilesMatch>
