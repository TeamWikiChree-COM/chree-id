# ftps / ftp / sftp
FTP_PROTOCOL=ftps

FTP_HOST=m5.coreserver.jp
FTP_USER=your-account
FTP_PASS=your-password

# ftps/ftp は 21、sftp は 22
FTP_PORT=21

# 転送先。ftps ではログイン後のルートからの相対 (/public_html/chreeid)、
# sftp では絶対パス (/virtual/<account>/public_html/chreeid) になる点に注意。
FTP_DIR=/public_html/chreeid

# FTP_KEY=C:\Users\you\.ssh\id_rsa
