APP_NAME=ChreeID
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chreeid
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# smtp/log
MAIL_MAILER=log
# MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OIDC issuer。RP は完全一致で検証するので末尾スラッシュを付けない。
CHREEID_ISSUER="${APP_URL}"
# ID Token 署名鍵 (base64)。生成は `php artisan chreeid:generate-key`。
CHREEID_SIGNING_KEY=
# ID Token の寿命 (秒)
CHREEID_ID_TOKEN_TTL=3600

# Cloudflare Turnstile。両方入っているときだけ検証が有効になる。
# 空のままなら登録・ログインの検証を丸ごと飛ばすので、ローカルでは設定不要
CHREEID_TURNSTILE_SITE_KEY=
CHREEID_TURNSTILE_SECRET_KEY=

# 登録の確認メールに載せるリンクの有効分数
CHREEID_REGISTRATION_TTL_MINUTES=60

# 退会したアカウントを物理削除するまでの日数
CHREEID_ACCOUNT_PURGE_DAYS=31

# バックアップの暗号鍵 (base64)。生成は `openssl rand -base64 32`。
# 空のままならバックアップは取らない (暗号化できない控えを残さないため)
CHREEID_BACKUP_KEY=
# サーバ内 (storage/app/private/backups) にも置くか、と残す日数
CHREEID_BACKUP_LOCAL=true
CHREEID_BACKUP_LOCAL_DAYS=7
# Google Drive に残す世代数
CHREEID_BACKUP_KEEP=14
# Google Drive。4つ揃ったときだけ送る
CHREEID_BACKUP_DRIVE_CLIENT_ID=
CHREEID_BACKUP_DRIVE_CLIENT_SECRET=
CHREEID_BACKUP_DRIVE_REFRESH_TOKEN=
CHREEID_BACKUP_DRIVE_FOLDER_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub の OAuth App。コールバックは <issuer>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 管理画面に入れるアカウント (カンマ区切り)。検証済みのアドレスのみ有効
CHREEID_ADMIN_EMAILS=
