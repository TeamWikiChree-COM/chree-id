APP_NAME=ChreeID
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chreeid
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OIDC issuer。RP は完全一致で検証するので末尾スラッシュを付けない。
CHREEID_ISSUER="${APP_URL}"
# ID Token 署名鍵 (base64)。生成は `php artisan chreeid:generate-key`。
CHREEID_SIGNING_KEY=

# Cloudflare Turnstile。両方入っているときだけ検証が有効になる。
# 空のままなら登録・ログインの検証を丸ごと飛ばすので、ローカルでは設定不要
CHREEID_TURNSTILE_SITE_KEY=
CHREEID_TURNSTILE_SECRET_KEY=

# 登録の確認メールに載せるリンクの有効分数
CHREEID_REGISTRATION_TTL_MINUTES=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
